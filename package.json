{
  "name": "organize-classnames",
  "displayName": "Organize ClassNames",
  "description": "Sorts the class names in class=\"\u2026\" and className=\"\u2026\" attributes alphabetically on save. HTML, JSX, TSX, Vue. No configuration needed.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "activationEvents": [
    "onLanguage:html",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:vue"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "organizeClassnames.sort",
        "title": "Organize ClassNames: Sort class names in this file"
      }
    ],
    "configuration": {
      "title": "Organize ClassNames",
      "properties": {
        "organizeClassnames.onSave": {
          "type": "boolean",
          "default": true,
          "description": "Sort class names automatically when a file is saved."
        },
        "organizeClassnames.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "html",
            "javascript",
            "javascriptreact",
            "typescript",
            "typescriptreact",
            "vue"
          ],
          "description": "Language ids the extension acts on."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src --ext ts",
    "test": "npm run compile-tests && node --test out/test/"
  },
  "devDependencies": {
    "@types/vscode": "^1.92.0",
    "@types/mocha": "^10.0.7",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.14.1",
    "@typescript-eslint/parser": "^7.11.0",
    "eslint": "^8.57.0",
    "esbuild": "^0.21.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.5",
    "@vscode/test-cli": "^0.0.9",
    "@vscode/test-electron": "^2.4.0"
  },
  "publisher": "juapperez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juapperez/organize-classnames.git"
  },
  "homepage": "https://github.com/juapperez/organize-classnames#readme",
  "bugs": {
    "url": "https://github.com/juapperez/organize-classnames/issues"
  },
  "keywords": [
    "class",
    "className",
    "tailwind",
    "sort",
    "format",
    "html",
    "jsx",
    "tsx"
  ]
}
